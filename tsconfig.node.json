{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `api/` corre na Vercel (Node), não no browser — por isso entra neste
  // projeto e não no `tsconfig.app.json`. Sem estar aqui, não era verificado
  // por ninguém: um erro de tipo na função serverless só aparecia em produção.
  "include": ["vite.config.ts", "api"]
}
